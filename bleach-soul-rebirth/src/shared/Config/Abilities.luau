-- Definições de habilidades orientadas a dados. Cada `kind` é executado por um handler genérico
-- no servidor (AbilityService) e tem uma representação visual genérica no cliente (VFX/AbilityFx).
--
-- Campos comuns:
--   name, kanji (ícone), desc, kind, element (nil = elemento do poder/facção), anim (pose de conjuração)
--   windup (s até o efeito), duration (s de bloqueio de ação), cooldown, cost (Reiatsu)
--   damage, stun, knockback, launch, superArmor, ultimate (câmera cinematográfica)
-- Kinds:
--   Projectile: speed, range, radius, count, spread, pierce, shape, size, explodeRadius
--   Beam:       length, radius, ticks, interval, shape
--   DashStrike: distance, width, hits, behind (aparece atrás do alvo), leap (salto em arco)
--   Burst:      target ("Self"|"Aim"), range, radius, ticks, interval, delay
--   Rain:       range, radius, ticks, interval
--   Buff:       buffDuration, buff = { damage, defense, speed }, radius (pulso opcional)
--   Pull:       range, width
--   Barrage:    range, angle, ticks, interval

local Abilities = {}

local DEFAULTS = {
	windup = 0.3,
	duration = 0.6,
	cooldown = 6,
	cost = 15,
	damage = 10,
	stun = 0.6,
	knockback = 15,
	anim = "CastPoint",
}

local function add(id: string, def: { [string]: any })
	for k, v in DEFAULTS do
		if def[k] == nil then
			def[k] = v
		end
	end
	def.id = id
	Abilities[id] = def
end

