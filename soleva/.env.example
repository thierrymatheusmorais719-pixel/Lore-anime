# Provedor de pagamento: demo | mercadopago | stripe
# Sem credenciais/back-end configurados, o checkout roda em MODO DEMONSTRAÇÃO.
VITE_PAYMENT_PROVIDER=demo

# URL do seu back-end (cria a sessão/preferência de pagamento e recebe webhooks).
# As chaves secretas do Stripe/Mercado Pago ficam SOMENTE no back-end.
VITE_API_URL=

# Chave pública (opcional, para SDKs client-side)
VITE_MERCADOPAGO_PUBLIC_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
