{
  "name": "DueloFeiticeiros",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Duelo": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": true, "RespawnTime": 2 }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 0.3,
        "Brightness": 1.2,
        "Ambient": [0.16, 0.16, 0.24],
        "OutdoorAmbient": [0.22, 0.2, 0.32],
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 0.6,
        "GlobalShadows": true
      }
    },
    "Workspace": {
      "$properties": { "StreamingEnabled": false, "FallenPartsDestroyHeight": -400 }
    }
  }
}
