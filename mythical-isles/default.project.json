{
  "name": "MythicalIsles",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 20,
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 8
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": { "RespawnTime": 4, "CharacterAutoLoads": false }
    },
    "Workspace": {
      "$properties": { "StreamingEnabled": false, "FallenPartsDestroyHeight": -300 },
      "Terrain": { "$className": "Terrain" }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 14.5,
        "Brightness": 2.2,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.7,
        "EnvironmentSpecularScale": 0.6
      }
    },
    "SoundService": {
      "$properties": { "RespectFilteringEnabled": true }
    }
  }
}
